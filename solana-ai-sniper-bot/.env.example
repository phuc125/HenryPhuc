# ==============================================================================
# SOLANA AUTONOMOUS QUANT MEMECOIN SNIPER BOT - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================================
# Hướng dẫn: Copy file này thành ".env" (lệnh: cp .env.example .env) rồi điền
# thông tin của bạn. Tuyệt đối KHÔNG chia sẻ file .env cho bất kỳ ai!

# ------------------------------------------------------------------------------
# 1. VÍ SOLANA & CHẾ ĐỘ GIAO DỊCH (PAPER / LIVE)
# ------------------------------------------------------------------------------
# Private Key của ví phụ Solana (định dạng Base58 từ Phantom/Solflare).
# Ở chế độ PAPER có thể để trống; chế độ LIVE bắt buộc phải có PRIVATE_KEY hợp lệ có SOL.
PRIVATE_KEY=

# Chế độ chạy mặc định khi khởi động: PAPER hoặc LIVE
TRADING_MODE=PAPER

# Số vốn SOL ảo ban đầu cho chế độ PAPER (mặc định 10 SOL)
PAPER_INITIAL_BALANCE_SOL=10

# ------------------------------------------------------------------------------
# 2. CHẾ ĐỘ QUÉT SÀN KHÔNG CẦN MUA GÓI RPC (FREE_FEED) HOẶC RPC RIÊNG
# ------------------------------------------------------------------------------
# - FREE_FEED : (Mặc định) Quét realtime qua GeckoTerminal + DexScreener API miễn phí,
#               kết hợp xoay vòng nhiều Public RPC miễn phí -> KHÔNG CẦN MUA GÓI RPC!
# - HYBRID    : Kết hợp WebSocket RPC + Free Feed (khi có Helius/QuickNode)
# - RPC_WSS   : Chỉ dùng WebSocket RPC thuần
DISCOVERY_MODE=FREE_FEED

# Chu kỳ quét Free Feed & vị thế (ms), tối thiểu 5000ms (5–10 giây để tránh 429)
FREE_FEED_POLL_MS=8000
POSITION_POLL_MS=5000

# Tham số chống Rate-Limit (429): delay thử lại ban đầu (5-10s), max retries (2-3), global cooldown (30-60s), cache (5-10s)
API_INITIAL_RETRY_DELAY_MS=5000
API_MAX_RETRIES=2
API_GLOBAL_COOLDOWN_MS=45000
API_CACHE_TTL_MS=8000

# KHÔNG BẮT BUỘC điền nếu chạy FREE_FEED!
RPC_HTTPS_URL=
RPC_WSS_URL=
RPC_FALLBACK_URL=https://solana-rpc.publicnode.com

# Endpoint Jito Block Engine gần nhất (Tokyo / Amsterdam / Frankfurt / NY / SLC)
JITO_BLOCK_ENGINE_URL=https://tokyo.mainnet.block-engine.jito.wtf/api/v1/bundles

# Mức Tip mặc định cho Jito Validator (SOL). Bot tự động scale theo Jito Floor & giới hạn MAX_FEE_RATIO_PCT.
JITO_TIP_SOL=0.001

# ------------------------------------------------------------------------------
# 3. MOBILE APP API (THAY THẾ TELEGRAM) & CHẾ ĐỘ WI-FI / TIẾT KIỆM 4G
# ------------------------------------------------------------------------------
# Cổng HTTP REST API cho App iOS/Web điều khiển ví, backtest & toggles
APP_API_PORT=3100

# Chỉ hoạt động trên Wi-Fi (mặc định true). Nếu đang dùng 4G sẽ tạm dừng hoặc ép tiết kiệm tối đa
WIFI_ONLY_MODE=true
LOW_DATA_4G_MODE=false
LOW_DATA_4G_POLL_MS=45000

# ------------------------------------------------------------------------------
# 4. BỘ LỌC THANH KHOẢN, ORDERFLOW & ANTI-RUG 5 LỚP TỰ ĐỘNG
# ------------------------------------------------------------------------------
# Bật/tắt snipe token Create thô trên Pump.fun (mặc định false -> ưu tiên Migration / Raydium / Meteora)
SNIPE_PUMP_CREATE=false

# Thời gian chờ quan sát (ms) với pool on-chain mới để né nhiễu Block-0
OBSERVATION_DELAY_MS=4000

# Thanh khoản pool tối thiểu (USD) & ngưỡng Orderflow
MIN_LIQUIDITY_USD=8000
MIN_UNIQUE_BUYERS=4
MIN_BUY_COUNT=5
MIN_VOLUME_SPIKE_RATIO=0.5

# Chênh lệch Mua-Bán vòng tròn tối đa (%) & tỷ lệ phí 2 chiều tối đa (%)
MAX_ROUNDTRIP_SPREAD_PCT=12
MAX_FEE_RATIO_PCT=6

# Thời gian nghỉ giữa 2 lần snipe (ms) & Circuit Breaker chuỗi thua
ENTRY_COOLDOWN_MS=4000
MAX_CONSECUTIVE_LOSSES=4

# Ngưỡng Anti-Rug 5 lớp (LP Burn, Top 10 Holders, Dev Hold, Block-0 Bundle)
MIN_LP_BURNED_PCT=90
MAX_TOP10_HOLDERS_PCT=32
MAX_DEV_HOLD_PCT=6
MAX_BUNDLE_SUPPLY_PCT=30

# ------------------------------------------------------------------------------
# 5. QUẢN TRỊ VỐN TỰ ĐỘNG 1% BALANCE & CHIẾN LƯỢC CHỐT LỜI
# ------------------------------------------------------------------------------
# Tự động hóa 100% khối lượng vào lệnh theo rủi ro % tổng Balance:
#   Risk Budget = Balance * (RISK_PER_TRADE_PCT / 100)
#   Position Size = Risk Budget / (HARD_SL_PCT / 100) * Quality Multiplier
# VD: Balance = 10 SOL, Risk 1%, Hard SL -25% => Risk = 0.10 SOL => Base Size = 0.40 SOL.
RISK_PER_TRADE_PCT=1

# Tự động khóa Auto-Snipe nếu lỗ thực tế trong ngày vượt % Balance (mặc định 5%)
MAX_DAILY_LOSS_PCT=5

# Giới hạn tối đa 1 vị thế (% Balance) & tổng Heat toàn danh mục (% Balance)
MAX_SINGLE_POSITION_PCT=15
MAX_PORTFOLIO_HEAT_PCT=35

# Trượt giá tối đa (bps) & Priority Fee trần
SLIPPAGE_BPS=1200
MAX_PRIORITY_FEE_LAMPORTS=100000

# Chốt lời đa tầng + Trailing Take Profit + Break-Even Lock + Trailing SL
TP1_PCT=45
TP1_SELL_SHARE_PCT=50
TP2_PCT=120
TP2_SELL_SHARE_PCT=30
TRAILING_TP_ENABLED=true
TRAILING_TP_CALLBACK_PCT=8
BREAKEVEN_ACTIVATE_PCT=18
TRAILING_ACTIVATE_PCT=28
TRAILING_CALLBACK_PCT=12
HARD_SL_PCT=25
TIME_EXIT_MINUTES=12

# RUG_DRAIN khẩn cấp (5 ticks mất giá kèm xác nhận snapshot, hoặc thanh khoản tụt dưới 35%)
RUG_DRAIN_MISS_TICKS=5
RUG_DRAIN_LIQ_RATIO=0.35

# Dynamic Jito Tip & bật/tắt các bộ lọc/logic nâng cao (có thể bật/tắt trực tiếp trên Telegram)
DYNAMIC_JITO_TIP_ENABLED=true
HONEYPOT_SIM_ENABLED=true
LP_LOCK_CHECK_ENABLED=true
ANTI_BUNDLE_CHECK_ENABLED=true
ORDERFLOW_FILTER_ENABLED=true
WASH_TRADE_GUARD_ENABLED=true
MOMENTUM_FILTER_ENABLED=true
SPREAD_GUARD_ENABLED=true
COOLDOWN_GUARD_ENABLED=true
BREAKEVEN_LOCK_ENABLED=true
EARLY_MOMENTUM_CUT_ENABLED=true
TIME_EXIT_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true
AUTO_DELETE_ENTRY_MSG_ENABLED=true
BLACKLISTED_CREATORS=

# ------------------------------------------------------------------------------
# 6. AI INTELLIGENCE, SMART MONEY, MARKET REGIME & CONTINUOUS LEARNING (v7)
# ------------------------------------------------------------------------------
AI_INTELLIGENCE_ENABLED=true
SMART_MONEY_FILTER_ENABLED=true
MARKET_REGIME_GUARD_ENABLED=true
ADAPTIVE_ENTRY_ENABLED=true
SOCIAL_INTELLIGENCE_ENABLED=true
CONTINUOUS_LEARNING_ENABLED=true
MIN_AI_QUALITY_SCORE=52
MIN_ENTRY_RANK_SCORE=54
MAX_PRICE_IMPACT_PCT=7.5
MAX_WEEKLY_LOSS_PCT=12
PROFIT_PROTECTION_PCT=40
TWITTER_BEARER_TOKEN=
SMART_WALLETS_SEED=

# ------------------------------------------------------------------------------
# 7. TỰ ĐỘNG THU HỒI RENT FEE & GOM LỢI NHUẬN VỀ VÍ LẠNH (AUTO-CONSOLIDATE)
# ------------------------------------------------------------------------------
# Tự động đóng tài khoản token đã bán hết (balance = 0) để thu hồi ~0.00204 SOL rent
AUTO_RENT_RECLAIM_ENABLED=true
# Tự động chuyển SOL dư vượt ngưỡng về ví lạnh an toàn (chỉ LIVE)
AUTO_CONSOLIDATE_ENABLED=false
COLD_WALLET_ADDRESS=
CONSOLIDATE_THRESHOLD_SOL=2.0
CONSOLIDATE_KEEP_SOL=1.0

# Đường dẫn lưu Database SQLite
SQLITE_DB_PATH=./data/sniper.db
